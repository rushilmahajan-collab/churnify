{
  "name": "retainiq-backend",
  "version": "1.0.0",
  "description": "RetainIQ - Retention Intelligence Dashboard Backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["retention", "churn", "saas", "stripe"],
  "author": "RetainIQ",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "drizzle-orm": "^0.30.10",
    "pg": "^8.11.2",
    "redis": "^4.6.11",
    "bull": "^4.11.4",
    "node-cron": "^3.0.2",
    "stripe": "^14.8.0",
    "resend": "^2.0.0",
    "pino": "^8.16.2",
    "pino-http": "^8.4.1",
    "pino-pretty": "^10.2.3",
    "jose": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/cors": "^2.8.17",
    "@types/bull": "^4.10.5",
    "@types/bcryptjs": "^2.4.6",
    "drizzle-kit": "^0.20.14",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0"
  }
}
